# NPU-LLM Environment Variables
# Copy this file to .env and customize as needed

# Model cache directory
# Default: ~/.cache/npu_llm
NPU_LLM_CACHE_DIR=~/.cache/npu_llm

# Default device for inference
# Options: NPU, CPU, GPU, AUTO
NPU_LLM_DEVICE=NPU

# Default backend for inference
# Options: openvino, onnxruntime
NPU_LLM_BACKEND=openvino

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
NPU_LLM_LOG_LEVEL=INFO

# Optional: Specific model to use
# NPU_LLM_MODEL_ID=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Optional: HuggingFace token for accessing gated models
# HF_TOKEN=your_huggingface_token_here

# Optional: OpenVINO specific settings
# OV_PERFORMANCE_HINT=LATENCY
# OV_NUM_STREAMS=1

# Optional: ONNX Runtime specific settings
# ORT_TENSORRT_FP16_ENABLE=1
