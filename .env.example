# Flask Application Settings
SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///app.db
DATABASE_NAME=app.db

# API Settings
API_HOST=0.0.0.0
API_PORT=5000

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key
JWT_EXPIRATION_HOURS=24

# Email Configuration (for 05_email_sender.py)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Security Settings
PASSWORD_HASH_ALGORITHM=sha256
ENABLE_RATE_LIMITING=True
MAX_REQUESTS_PER_MINUTE=60

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log
ENABLE_FILE_LOGGING=True

# Web Scraping Settings
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
REQUEST_TIMEOUT=10

# Selenium Settings (for 31_web_automation.py)
SELENIUM_HEADLESS=True
CHROMEDRIVER_PATH=/usr/local/bin/chromedriver

# File Storage
UPLOAD_FOLDER=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,pdf,txt,csv

# Encryption Settings (for 06_file_encryption.py)
ENCRYPTION_KEY_SIZE=32

# Backup Settings (for 37_backup_tool.py)
BACKUP_DIRECTORY=./backups
BACKUP_RETENTION_DAYS=30

# Development Settings
DEBUG_MODE=True
TESTING=False
